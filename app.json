{
  "expo": {
    "name": "Ritmo",
    "slug": "ritmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ritmo",
    "platforms": [
      "android"
    ],
    "assetBundlePatterns": [
      "assets/images/**",
      "assets/ringtone/**",
      "assets/voiceover/**",
      "assets/Tutorials/**",
      "assets/background.png",
      "assets/ritmo-logo.png",
      "assets/ritmo-header.png",
      "assets/evening.png",
      "assets/Success.png"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ],
      "package": "com.ritmov1.ritmo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ritmo-header.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/ritmo-header.png",
          "color": "#5BDFC9",
          "sounds": [
            "./assets/ringtone/alarm1.mp3",
            "./assets/ringtone/alarm2.mp3",
            "./assets/ringtone/alarm3.mp3",
            "./assets/ringtone/alarm4.mp3",
            "./assets/ringtone/alarm5.mp3",
            "./assets/ringtone/alarm6.mp3",
            "./assets/ringtone/alarm7.mp3",
            "./assets/ringtone/alarm8.mp3",
            "./assets/ringtone/alarm13.mp3",
            "./assets/ringtone/alarm14.mp3",
            "./assets/ringtone/alarm15.mp3",
            "./assets/ringtone/alarm16.mp3",
            "./assets/ringtone/alarm17.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c86fb750-ff00-4af5-b983-1daa39fffbbb"
      }
    },
    "owner": "brentspeed69",
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
