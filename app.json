{
  "expo": {
    "name": "Ritmo",
    "slug": "ritmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ritmo-logo.png",
    "scheme": "ritmo",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/ritmo-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ],
      "package": "com.anonymous.ritmo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ritmo-header.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/ritmo-header.png",
          "color": "#5BDFC9",
          "sounds": [
            "./assets/ringtone/alarm1.mp3",
            "./assets/ringtone/alarm2.mp3",
            "./assets/ringtone/alarm3.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e25dcc6-6321-45f8-bf99-8637625bdc1e"
      }
    }
  }
}
