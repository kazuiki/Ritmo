<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="org.godotengine.rendering.method"
            android:value="gl_compatibility" />
        <meta-data
            android:name="org.godotengine.editor.version"
            android:value="4.6.stable" />
        <meta-data
            android:name="org.godotengine.library.version"
            android:value="4.6.0.stable" />

        <activity
            android:name=".RitmoGodotActivity"
            android:exported="true"
            android:process=":godot"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:noHistory="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EatGodotActivity"
            android:exported="true"
            android:process=":godot_eat"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:noHistory="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrushGodotActivity"
            android:exported="true"
            android:process=":godot_brush"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:noHistory="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EatGodotActivityLauncher"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".BathGodotActivity"
            android:exported="true"
            android:process=":godot_bath"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:noHistory="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MakeHairGodotActivity"
            android:exported="true"
            android:process=":godot_hair"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:noHistory="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrushGodotActivityLauncher"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".BathGodotActivityLauncher"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".MakeHairGodotActivityLauncher"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".RitmoGodotActivityLauncher"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
